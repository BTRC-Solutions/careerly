{
  "name": "@careerly/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and types shared by the Careerly API and UI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
