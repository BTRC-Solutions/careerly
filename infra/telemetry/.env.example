# Careerly's telemetry on the VPS: copy to ~/careerly/.env (chmod 600). It never goes into the repository.
# Passwords and the secret go inside URLs: generate them with `openssl rand -hex 32` (hex only).

# The one public host (ARCHITECTURE §19.6): an A record of btrc.website pointing at the VPS.
CAREERLY_DOMAIN=careerly.btrc.website

# Image tag to run: sha-<commit> of the deployment branch, or latest.
IMAGE_TAG=latest

# Postgres owner (runs the migrations) and telemetry_app (the receiver: read and insert only).
POSTGRES_PASSWORD=
TELEMETRY_DB_PASSWORD=

# Shared by stats-web and telemetry-api for the read API (at least 32 characters).
TELEMETRY_INTERNAL_SECRET=

# Leading zero bits of a new installation's proof of work (ADR-26).
#TELEMETRY_POW_DIFFICULTY=20
