# Jenkins on the VPS: copy to ~/careerly/jenkins/.env (chmod 600). It never goes into the repository.

# The only Jenkins user (JCasC, no sign-up). Generate the password with `openssl rand -hex 24`.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# The VPS user Jenkins deploys as, over SSH to its own host (in the docker group).
VPS_SSH_USER=bruno
VPS_SSH_PORT=5141

# Folder with id_ed25519 (Jenkins's deploy key) and known_hosts. Default ~/careerly/jenkins.
#JENKINS_SECRETS_DIR=/home/bruno/careerly/jenkins
