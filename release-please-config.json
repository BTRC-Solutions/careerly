{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "c9e1ce359dcd01706bf136fe12cd3f155c995b4e",
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "careerly",
      "component": "careerly",
      "include-component-in-tag": false,
      "versioning": "always-bump-patch",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["apps/telemetry-api", "apps/stats-web", "infra"],
      "extra-files": [
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/contracts/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/desktop'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/api'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/contracts'].version"
        }
      ]
    }
  }
}
