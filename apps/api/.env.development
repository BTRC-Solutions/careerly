# Development-only settings for `npm run dev` / `npm run dev:web`.
# These values are NOT secret: in the packaged app, Electron generates a random token on every launch.
CAREERLY_DATA_DIR=../../.data
CAREERLY_API_PORT=4317
CAREERLY_API_TOKEN=careerly-dev-token-not-secret
CAREERLY_ALLOWED_ORIGINS=http://localhost:5173
CAREERLY_LOG_LEVEL=debug
CAREERLY_LOG_TO_STDOUT=true
