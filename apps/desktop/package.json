{
  "name": "@careerly/desktop",
  "productName": "Careerly",
  "version": "0.8.0",
  "private": true,
  "description": "Electron shell for Careerly.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,electron -c gray,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"electron . --dev\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/package-app.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2"
  }
}
