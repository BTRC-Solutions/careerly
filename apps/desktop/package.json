{
  "name": "@careerly/desktop",
  "productName": "Careerly",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell for Careerly.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,electron -c gray,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"electron . --dev\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^45.2.3"
  }
}
