# Used only by `npm run dev`: Electron loads the Vite dev server and talks to the API started by
# `npm run dev -w @careerly/api` (see apps/api/.env.development). These values are NOT secret.
CAREERLY_DEV_SERVER_URL=http://localhost:5173
CAREERLY_API_URL=http://127.0.0.1:4317
CAREERLY_API_TOKEN=careerly-dev-token-not-secret
